[Unit]
Description=UDP bridges for follower mpv
After=network.target

[Service]
Type=exec
WorkingDirectory=/home/tu-studio/content
ExecStart=/bin/bash -c 'socat -u UDP4-RECVFROM:12338,broadcast,fork,reuseaddr UNIX-CONNECT:/tmp/mpvsocket & socat -u UDP4-RECVFROM:12340,broadcast,fork,reuseaddr UNIX-CONNECT:/tmp/mpvsocket & wait -n'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
