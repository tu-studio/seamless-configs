[Unit]
Description=UDP control bridge for leader mpv
After=network.target
[Service]
StandardOutput=journal
StandardError=journal
Type=exec
WorkingDirectory=/home/tu-studio/content
ExecStart=/usr/bin/socat -u -v UDP4-RECVFROM:12339,broadcast,fork,reuseaddr UNIX-CONNECT:/tmp/mpvsocket
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
